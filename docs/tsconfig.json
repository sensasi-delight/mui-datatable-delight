{
    "compilerOptions": {
        "allowJs": true,
        "incremental": true,
        "jsx": "react-jsx",

        "paths": {
            "@/*": ["../*"],
            "@src": ["../src"],
            "@src/*": ["../src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ],
        "resolveJsonModule": true
    },
    "exclude": ["node_modules"],
    "extends": "../tsconfig.json",
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx",
        "../src"
    ]
}
